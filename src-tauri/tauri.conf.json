{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Divixi",
  "version": "0.1.0",
  "identifier": "app.divixi",
  "mainBinaryName": "divixi",
  "build": {
    "devUrl": "http://localhost:5183",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/jaemin93/divixi/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1M0E4Mzc5RjI0NzEzMUIKUldRYkUwZnllWU02NVJiOEc5b05rckg1M0lHMGVWQitWM2hsZm5YemEvdjhoVndVcGQ1VGVldm0K"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Divixi",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 640,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: asset: http://asset.localhost board: http://board.localhost; connect-src 'self' ipc: http://ipc.localhost; frame-src preview: http://preview.localhost board: http://board.localhost"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "The divixi contributors",
    "homepage": "https://github.com/jaemin93/divixi",
    "copyright": "Copyright 2026 The divixi contributors",
    "shortDescription": "One conductor, many agents.",
    "longDescription": "One conductor, many agents. A desktop app for directing coding agents: you talk to one conductor, and it divides the work among worker sessions that run side by side.",
    "licenseFile": "../LICENSE",
    "category": "DeveloperTool",
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
