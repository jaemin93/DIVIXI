{
  "name": "divixi",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "One conductor, many agents. A desktop app for directing coding agents: you talk to one conductor, and it divides the work among worker sessions that run side by side.",
  "author": "The divixi contributors",
  "homepage": "https://github.com/jaemin93/divixi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaemin93/divixi.git"
  },
  "bugs": {
    "url": "https://github.com/jaemin93/divixi/issues"
  },
  "keywords": [
    "tauri",
    "svelte",
    "rust",
    "coding-agent",
    "acp",
    "agent-client-protocol",
    "desktop"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test \"ui/src/lib/**/*.test.ts\"",
    "check": "svelte-check --tsconfig ./tsconfig.json --tsgo --output human",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:readme": "node scripts/check-readmes.mjs",
    "tauri": "tauri",
    "app": "tauri dev"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.15",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14",
    "marked-highlight": "^2.2.4",
    "perfect-freehand": "^1.2.3"
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.79.0",
    "@agentclientprotocol/codex-acp": "^1.12.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^26.6.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "prettier": "^3.9.9",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.1"
  }
}
